<Window x:Class="pr11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr11"
        mc:Ignorable="d"
        Title="Игра кликер" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Border
             BorderBrush="Black"
             BorderThickness="1"
             Margin="10"
             Background="White">
            <Grid>
                <Image
                    Margin="10,10,10.2,185.4" Source="Resources\для пр3.jpg" />
                <Label  Content="Основные характеристики персонажа:" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontWeight="Bold" Margin="0,0,0,160"/>
                <Label Name="playerHealth" Content="Жизненные показатели: 100" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="10,0,0,130"/>
                <Label Name="playerArmor" Content="Броня: 100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,100"/>
                <Label Name="playerLevel" Content="Уровень: 1" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="10,0,0,70"/>
                <Label Name="playerGlasses" Content="Опыт: 0" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="10,0,0,40"/>
                <Label Name="playerMoney" Content="Монеты: 0" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="10,0,0,10"/>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Margin="10" Background="#FFFDFDFD" Grid.Column="1" MouseDown="AttackEnemy">
            <Grid>
                <Image Name="emptyImage" Margin="10,10,10.2,185.4" Source="Resources\yflj.png"/>
                <Label Content="Основные характеристики персонажа:" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontWeight="Bold" Margin="10,0,0,160"/>
                <Label Name="emptyHealth" Content="Жизненные показатели: 100" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="10,0,0,130"/>
                <Label Name="emptyArmor" Content="Броня: 100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,100"/>
                <Label Name="emptyLevel" Content="Уровень: 1" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="10,0,0,70"/>
                <Label Name="emptyGlasses" Content="Опыт: 0" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="10,0,0,40"/>
                <Label Name="emptyMoney" Content="Монеты: 0" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Margin="10,0,0,10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
